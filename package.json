{
  "name": "matchupvn-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "MatchUpVN monorepo — web app + admin panel",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
